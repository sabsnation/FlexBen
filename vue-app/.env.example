# ── Desenvolvimento local (recomendado) ──
# Proxy Vite em vite.config.js: /api → http://127.0.0.1:3333
VITE_API_BASE_URL=/api

# ── Ou apontar direto ao backend local (sem proxy) ──
# VITE_API_BASE_URL=http://127.0.0.1:3333/api

# ── Front local + API no Render ──
# VITE_API_BASE_URL=/api
# VITE_DEV_REMOTE_API=1

# ── Build manual apontando ao Render (sem proxy Vercel) ──
# VITE_API_BASE_URL=https://flexben.onrender.com/api

# Login com Google (Client ID público — não é o Client Secret)
# VITE_GOOGLE_CLIENT_ID="seu-id.apps.googleusercontent.com"
