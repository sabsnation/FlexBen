# =========================================================
# Backend — variáveis de ambiente
# Copie para `backend/.env` e ajuste para o seu ambiente.
# =========================================================

# ── Núcleo ──
NODE_ENV=development
PORT=3333
JWT_SECRET="altere-em-producao"

# Login com Google (OAuth 2.0 — mesmo Client ID do front VITE_GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID="seu-id.apps.googleusercontent.com"

# URL do frontend para CORS em produção (Vercel). Em dev, deixe em branco.
# Múltiplas URLs separadas por vírgula.
# FRONTEND_URL="https://flexben.vercel.app"

# ── Banco principal ──
# Local sem Docker (SQLite — padrão do projeto em dev):
DATABASE_URL="file:./dev.db"
# Local com docker compose (PostgreSQL):
# DATABASE_URL="postgresql://corp:corp@localhost:5432/corpbenefit"
# Produção (Render): Postgres via variável automática do Blueprint (ensure-prisma-provider ajusta o schema).

# ── E-mail (recuperação de senha) — opcional ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=senha-de-app
# SMTP_FROM="FlexBen <noreply@empresa.com>"

# ── Mensageria (notificações) ──
# Sem RABBITMQ_URL: eventos processados inline no mesmo processo da API.
# Com Docker: docker compose up -d rabbitmq
# RABBITMQ_URL="amqp://flexben:flexben@localhost:5672"

# ── Auditoria (opcional) ──
# Provider: firestore | mongo | noop  (deixe vazio para auto-detectar)
# AUDIT_PROVIDER=mongo

# Firestore — JSON da service account em UMA linha:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'
# ou caminho para arquivo JSON:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# MongoDB (Atlas ou local):
# MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB="flexben"
# MONGODB_AUDIT_COLLECTION="audit_events"
