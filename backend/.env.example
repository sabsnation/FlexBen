# Local com Docker: docker compose up -d (na raiz do projeto)
DATABASE_URL="postgresql://corp:corp@localhost:5432/corpbenefit"

# Produção (Render): use a Internal Database URL do Postgres
# DATABASE_URL="postgresql://..."

JWT_SECRET="altere-em-producao"
PORT=3333

# URL do frontend na Vercel (CORS em produção)
# FRONTEND_URL="https://seu-app.vercel.app"

# --- Firebase / Firestore (opcional, só para auditoria) ---
# Baixe a chave JSON em: Firebase Console → Projeto → Engrenagem → Contas de serviço → Gerar nova chave privada
# Crie o Firestore: Build → Firestore Database → Criar banco
#
# Opção A — JSON da service account em UMA linha (aspas simples por fora):
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'
#
# Opção B — caminho para o arquivo JSON (recomendado; coloque o arquivo na pasta backend/):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Opção C — variável padrão do Google (mesmo efeito que B; caminho relativo ao diretório de onde você roda o Node):
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
