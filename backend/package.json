{
  "name": "flexben-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-port.js && node scripts/ensure-db-schema.js && node --watch src/server.js",
    "db:sync": "node scripts/ensure-prisma-provider.js && prisma db push",
    "dev:kill-port": "node scripts/free-port.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "node scripts/ensure-prisma-provider.js && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "start:prod": "prisma migrate deploy && node prisma/seed.js && node src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "morgan": "^1.10.0",
    "prisma": "^6.19.3"
  }
}
