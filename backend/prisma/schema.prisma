generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String         @unique
  authProvider  String         @default("password") @map("auth_provider")
  googleSub     String?        @unique @map("google_sub")
  passwordHash  String?        @map("password_hash")
  role          String
  status        String
  dataCadastro  String         @map("data_cadastro")
  avatarData    String?        @map("avatar_data")
  transactions  Transaction[]
  notifications Notification[]

  @@map("users")
}

model Notification {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String  @default("info")
  link      String?
  read      Boolean @default(false)
  dedupeKey String? @map("dedupe_key")
  createdAt String  @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@map("notifications")
}

model Category {
  id     Int     @id @default(autoincrement())
  nome   String
  limite Float
  status String

  @@map("categories")
}

model PolicyRule {
  id                Int    @id @default(autoincrement())
  role              String
  category          String
  costCenter        String @map("cost_center")
  maxPerTransaction Float  @map("max_per_transaction")
  monthlyCap        Float  @map("monthly_cap")
  requiresApproval  Boolean @default(false) @map("requires_approval")
  active            Boolean @default(true)

  @@map("policy_rules")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  tipo      String
  categoria String
  valor     Float
  status    String
  descricao String?
  events    WorkflowEvent[]

  @@index([userId])
  @@map("transactions")
}

model WorkflowEvent {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromStatus    String?     @map("from_status")
  toStatus      String      @map("to_status")
  actorEmail    String      @map("actor_email")
  note          String?
  createdAt     String      @map("created_at")

  @@index([transactionId])
  @@map("workflow_events")
}

model BenefitCeilingProposal {
  id                 Int      @id @default(autoincrement())
  requestType        String   @map("request_type")
  categoryId         Int?     @map("category_id")
  categoryName       String   @map("category_name")
  employeeRole       String   @default("colaborador") @map("employee_role")
  currentMonthlyCap  Float?   @map("current_monthly_cap")
  proposedMonthlyCap Float    @map("proposed_monthly_cap")
  proposedMaxPerTx   Float?   @map("proposed_max_per_tx")
  status             String
  justification      String?
  requesterEmail     String   @map("requester_email")
  requesterRole      String   @map("requester_role")
  createdAt          String   @map("created_at")
  events             CeilingProposalEvent[]

  @@map("benefit_ceiling_proposals")
}

model CeilingProposalEvent {
  id         Int                    @id @default(autoincrement())
  proposalId Int                    @map("proposal_id")
  proposal   BenefitCeilingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fromStatus String?                @map("from_status")
  toStatus   String                 @map("to_status")
  actorEmail String                 @map("actor_email")
  note       String?
  createdAt  String                 @map("created_at")

  @@index([proposalId])
  @@map("ceiling_proposal_events")
}
